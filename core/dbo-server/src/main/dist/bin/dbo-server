#!/usr/bin/env bash
# dbo serving distribution entrypoint: env -> system properties, then the
# standard Felix launcher. Exactly one provisioner mode should be set:
#   DBO_K8S_NAMESPACE            in-cluster (secrets-backed provisioner)
#   DBO_ADMIN_JDBC_URL/USER/PASSWORD  local default (database-per-tenant)
#
# DBO_MANAGEMENT_SPEC points at the spec of the tenant this deployment's own
# history lives in — the juridical body operating it. Outside
# DBO_TENANT_DIR on purpose: the scan loop that retracts undeclared tenants
# must not be able to retract the thing recording retractions. A deployment
# whose management tenant will not come up serves nothing.
set -euo pipefail
cd "$(dirname "$0")/.."

# REQ-DBO-AUTH-DENY-BY-DEFAULT: the deployment artifact refuses to serve
# without a working authority; disabling is an explicit embedded/test flag.
if [ -z "${DBO_AUTH_KEK:-}" ] && [ "${DBO_AUTH_DISABLED:-}" != "true" ]; then
  echo "dbo-server: refusing to serve tenants without an authority (REQ-DBO-AUTH-DENY-BY-DEFAULT)." >&2
  echo "Set DBO_AUTH_KEK (base64, 32 bytes) or explicitly DBO_AUTH_DISABLED=true (embedded/test only)." >&2
  exit 78
fi

# INFO by default: a box that says nothing while it works cannot be told
# apart from a box that is stuck.
DBO_LOG_LEVEL="${DBO_LOG_LEVEL:-info}"

# The framework's own verbosity, tracking ours unless overridden
# (0=none 1=error 2=warning 3=info 4=debug).
#
# dbo-logging listens for FrameworkEvents and puts container errors into the
# JSON stream, so those failures are structured and searchable. Felix ALSO
# writes them to the console in its own format, because its internal logger
# takes an object that only a programmatic launch could supply — and the
# serving distribution runs the standard launcher on purpose. The duplicate is
# the price of that.
#
# DBO_FELIX_LOG_LEVEL=0 buys a pure JSON stream, at the cost of the few
# messages Felix reports and does not publish as an event — auto-deploy
# failures among them. Worth it when something is parsing; not worth it when
# you are the one reading.
case "$DBO_LOG_LEVEL" in
  error) FELIX_LOG_LEVEL=1 ;;
  warn)  FELIX_LOG_LEVEL=2 ;;
  info)  FELIX_LOG_LEVEL=3 ;;
  *)     FELIX_LOG_LEVEL=4 ;;
esac
FELIX_LOG_LEVEL="${DBO_FELIX_LOG_LEVEL:-$FELIX_LOG_LEVEL}"

# Bundles that log through java.util.logging — the ServiceLoader mediator
# among them — would otherwise print their own INFO chatter beside the JSON
# stream in a different format entirely.
exec java \
  -Djava.util.logging.config.file=conf/logging.properties \
  -Ddbo.log.level="${DBO_LOG_LEVEL}" \
  -Ddbo.log.format="${DBO_LOG_FORMAT:-json}" \
  -Dfelix.log.level="${FELIX_LOG_LEVEL}" \
  -Ddbo.tenant.dir="${DBO_TENANT_DIR:?DBO_TENANT_DIR must point at the spec directory}" \
  -Ddbo.tenant.http.host="${DBO_HTTP_HOST:-0.0.0.0}" \
  -Ddbo.tenant.http.port="${DBO_HTTP_PORT:-8090}" \
  ${DBO_K8S_NAMESPACE:+-Ddbo.tenant.k8s.namespace="${DBO_K8S_NAMESPACE}"} \
  ${DBO_ADMIN_JDBC_URL:+-Ddbo.tenant.admin.url="${DBO_ADMIN_JDBC_URL}"} \
  ${DBO_ADMIN_USER:+-Ddbo.tenant.admin.user="${DBO_ADMIN_USER}"} \
  ${DBO_ADMIN_PASSWORD:+-Ddbo.tenant.admin.password="${DBO_ADMIN_PASSWORD}"} \
  ${DBO_AUTH_KEK:+-Ddbo.tenant.auth.kek="${DBO_AUTH_KEK}"} \
  ${DBO_AUTH_ISSUER_BASE:+-Ddbo.tenant.auth.issuer.base="${DBO_AUTH_ISSUER_BASE}"} \
  ${DBO_BROKER_ISSUER:+-Ddbo.tenant.auth.broker.issuer="${DBO_BROKER_ISSUER}"} \
  ${DBO_BROKER_CLIENT_ID:+-Ddbo.tenant.auth.broker.client.id="${DBO_BROKER_CLIENT_ID}"} \
  ${DBO_BROKER_CLIENT_SECRET:+-Ddbo.tenant.auth.broker.client.secret="${DBO_BROKER_CLIENT_SECRET}"} \
  ${DBO_BROKER_SUBJECT_STRIP:+-Ddbo.tenant.auth.broker.subject.strip="${DBO_BROKER_SUBJECT_STRIP}"} \
  ${DBO_AUTH_SUBJECT_SYSTEM:+-Ddbo.tenant.auth.subject.system="${DBO_AUTH_SUBJECT_SYSTEM}"} \
  ${DBO_BROKER_SECRETS:+-Ddbo.tenant.auth.broker.secrets="${DBO_BROKER_SECRETS}"} \
  ${DBO_OPS_TOKEN:+-Ddbo.tenant.ops.token="${DBO_OPS_TOKEN}"} \
  ${DBO_MANAGEMENT_SPEC:+-Ddbo.tenant.management.spec="${DBO_MANAGEMENT_SPEC}"} \
  ${DBO_JAVA_OPTS:-} \
  -jar bin/felix.jar
