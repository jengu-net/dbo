<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.19.xsd">
    <changeSet id="db-001" author="alan">
        <customChange class="io.dbobjects.db.postgres.liquibase.DatabaseDboVersionUpdate"/>
        <createTable tableName="dbo_node_state">
            <column name="app_code" type="VARCHAR">
                <constraints nullable="false"/>
            </column>
            <column name="app_ver" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="dbo_ver" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="dbo_type" type="VARCHAR">
                <constraints nullable="false"/>
            </column>
            <column name="node_id" type="VARCHAR">
                <constraints nullable="false"/>
            </column>
            <column name="node_heartbeat" type="BIGINT"/>
            <column name="node_status_code" type="VARCHAR"/>
            <column name="known_app_state_key" type="VARCHAR"/>
            <column name="attributes" type="JSONB"/>
        </createTable>
        <addUniqueConstraint tableName="dbo_node_state" columnNames="app_code, node_id"/>

        <createTable tableName="dbo_application_state">
            <column name="app_code" type="VARCHAR">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="app_ver" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="app_status_key" type="VARCHAR">
                <constraints nullable="false"/>
            </column>
            <column name="master_node" type="VARCHAR"/>
            <column name="blocked" type="BOOLEAN"/>
            <column name="attributes" type="JSONB"/>
        </createTable>
    </changeSet>
</databaseChangeLog>