{
  // Two passes over a declared configuration source.
  //
  // The second pass is the argument: an unchanged source re-applies nothing
  // that already agrees, and the card closes because the cause was fixed
  // rather than because somebody clicked it.

  // The site's palette. dbo.css maps every one of these onto its own --dbo-*
  // and wins, because Lini's defaults sit in a cascade layer — so these
  // values are only what the figure looks like opened away from the site.
  --ink: #111a24;   --body: #2c3a47;      --muted: #5d6c7b;  --faint: #8695a3;
  --panel: #ffffff; --line: #e3e0da;      --accent: #a8641b; --bg: #fbfaf8;
  --seal: #14532d;  --seal-soft: #e7f0e9; --accent-soft: #f6efe4;

  // Lini's own default stroke is a THREE-digit hex pair, and a three-digit
  // hex is indistinguishable from an issue reference to the branding ratchet
  // — which strips the six-digit form and cannot strip this one. Stating the
  // colour at full length keeps the check honest rather than loosened; and
  // dbo.css maps --lini-stroke onto the site palette like the rest, so this
  // value is only what a figure looks like away from the site.
  --stroke: #444444;
  font-family: "Google Sans"; color: --body;

  // A BARE STRING IS ALWAYS CENTRED in its parent, whatever `align` says;
  // only a block-wrapped one can be placed. So every piece of text that must
  // sit left is wrapped, and its container aligns to start.
  |t::block|       { font-size: 13; color: --body; }
  |small::t|       { font-size: 12.5; color: --muted; }
  |cap::t|         { font-weight: semibold; color: --ink; }
  |capf::cap|      { color: --faint; }
  |eyebrow::t|     { font-size: 11; font-weight: bold; letter-spacing: 1.2;
                     text-transform: uppercase; color: --faint; }
  |col::block|     { layout: flow; direction: column; align: start; gap: 6; }
  |panel::box|     { radius: 9; fill: --panel; stroke: --line; stroke-width: 1.5;
                     padding: 14; align: start; }
  |line-item::box| { radius: 5; fill: --bg; stroke: --line; stroke-width: 1.25;
                     height: 26; padding: 0 12; align: start; justify: center; }
  |lt::t|          { font-size: 12; }
  |chip::box|  { radius: 5; fill: --bg; stroke: --line; stroke-width: 1.25;
                 height: 24; padding: 0; justify: center; align: center;
                 font-size: 12; color: --body; }
  |live::chip| { fill: --accent-soft; stroke: --accent; color: --accent;
                 font-weight: semibold; }
  |ghost::chip| { fill: none; stroke-style: dashed; color: --faint; }
  |sealed::chip| { fill: --seal-soft; stroke: --seal; color: --seal;
                   font-weight: semibold; }
  |body::t|    { color: --muted; }
  |miss::t|    { color: --faint; }

  layout: flow; direction: column; align: start; width: 760;
  padding: 4; gap: 0; clearance: 2;
}

|block#passes| { layout: grid; columns: 370, 46, 344; gap: 0; align: start, start, start } [

  |col| { width: 370; gap: 0 } [
    |eyebrow| "First pass"
    |block| { height: 8 } []
    |block| { layout: grid; columns: 150, 44, 176; gap: 0; align: center, center, center } [
      |panel| { width: 150; height: 132; padding: 12 14 } [ |col| { width: 122; gap: 5 } [
        |cap| "the source"
        |small| "a repository, a mounted"
        |small| "directory, a lane"
        |chip| "5 declarations" { width: 122 }
        |small| "read as one set,"
        |small| "never one at a time"
      ] ]
      |block| { width: 44; height: 132 } [
        |line| { points: 0 0, 30 0; stroke: --accent; stroke-width: 1.75;
                 marker-end: arrow; pin: center } ]
      |panel| { width: 176; height: 132; padding: 12 14 } [ |col| { width: 148; gap: 6 } [
        |cap| "the pass, as a run"
        |live| "read 5" { width: 148 }
        |live| "applied 4" { width: 148 }
        |ghost| "skipped 1" { width: 148 }
      ] ]
    ]
    |block| { height: 22 } []
    |col| { width: 370; gap: 6 } [
      |body| "The one that failed is a card naming it — held work somebody can pick up."
      |body| "The other four applied. One bad declaration does not take the rest with it." ]
  ]

  |block| { width: 46 } []

  |col| { width: 344; gap: 0 } [
    |eyebrow| "Next pass, source unchanged"
    |block| { height: 8 } []
    |panel| { width: 344; height: 132; padding: 14 } [ |col| { width: 316; gap: 8 } [
      |chip| "the four that agree — a read, not a re-application" { width: 316; height: 26 }
      |live| "the scope with the open card — tried again" { width: 316; height: 26 }
      |sealed| "cause fixed at the source — the card closes itself" { width: 316; height: 26 }
    ] ]
    |block| { height: 22 } []
    |col| { width: 344; gap: 6 } [
      |body| "A sweep closes when what is here agrees"
      |body| "with what was declared." ]
    |block| { height: 10 } []
    |col| { width: 344; gap: 6 } [
      |miss| "Closing by click is how a card reads"
      |miss| "resolved while the fault is live." ]
  ]
]

|block| { height: 20 } []
|block#seam| { width: 760; height: 2; fill: --accent; }
|block| { height: 12 } []
|col| { gap: 6 } [
  |small| "A source that cannot be read says so — it never answers with an empty set, because"
  |small| "empty and unreachable are the same sentence to whoever must decide what is missing."
  |small| "Only a read the source calls COMPLETE may withdraw what it no longer names."
]
