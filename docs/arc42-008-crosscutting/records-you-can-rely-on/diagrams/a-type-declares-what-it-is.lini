{
  // A declaration on the left, and everything the engine then owes because of
  // it on the right. The derived layer is drawn apart and dashed because it
  // is not authoritative — rebuilding it is a background job.

  // The site's palette. dbo.css maps every one of these onto its own --dbo-*
  // and wins, because Lini's defaults sit in a cascade layer — so these
  // values are only what the figure looks like opened away from the site.
  --ink: #111a24;   --body: #2c3a47;      --muted: #5d6c7b;  --faint: #8695a3;
  --panel: #ffffff; --line: #e3e0da;      --accent: #a8641b; --bg: #fbfaf8;
  --seal: #14532d;  --seal-soft: #e7f0e9; --accent-soft: #f6efe4;

  // Lini's own default stroke is a THREE-digit hex pair, and a three-digit
  // hex is indistinguishable from an issue reference to the branding ratchet
  // — which strips the six-digit form and cannot strip this one. Stating the
  // colour at full length keeps the check honest rather than loosened; and
  // dbo.css maps --lini-stroke onto the site palette like the rest, so this
  // value is only what a figure looks like away from the site.
  --stroke: #444444;
  font-family: "Google Sans"; color: --body;

  // A BARE STRING IS ALWAYS CENTRED in its parent, whatever `align` says;
  // only a block-wrapped one can be placed. So every piece of text that must
  // sit left is wrapped, and its container aligns to start.
  |t::block|       { font-size: 13; color: --body; }
  |small::t|       { font-size: 12.5; color: --muted; }
  |cap::t|         { font-weight: semibold; color: --ink; }
  |capf::cap|      { color: --faint; }
  |eyebrow::t|     { font-size: 11; font-weight: bold; letter-spacing: 1.2;
                     text-transform: uppercase; color: --faint; }
  |col::block|     { layout: flow; direction: column; align: start; gap: 6; }
  |panel::box|     { radius: 9; fill: --panel; stroke: --line; stroke-width: 1.5;
                     padding: 14; align: start; }
  |line-item::box| { radius: 5; fill: --bg; stroke: --line; stroke-width: 1.25;
                     height: 26; padding: 0 12; align: start; justify: center; }
  |lt::t|          { font-size: 12; }
  |code::t|      { font-family: "Google Sans Code"; font-size: 12; }
  |live::box|    { radius: 7; fill: --accent-soft; stroke: --accent; stroke-width: 1.25;
                   height: 30; padding: 0; justify: center; align: center;
                   font-size: 12; font-weight: semibold; color: --accent; }
  |derived::box| { radius: 9; fill: none; stroke: --line; stroke-width: 1.5;
                   stroke-style: dashed; padding: 14 16; align: start; }

  layout: flow; direction: column; align: start; width: 760;
  padding: 4; gap: 0; clearance: 2;
}

|block#top| { layout: grid; columns: 292, 76, 392; gap: 0; align: start, start, start } [

  |col| { width: 292; gap: 0 } [
    |eyebrow| "What the tenant declares"
    |block| { height: 8 } []
    |panel| { height: 120; padding: 16 18 } [ |col| { gap: 6 } [
      |code| "{ \"name\": \"Patient\","
      |code| "  \"identity\": \"identifier\","
      |code| "  \"systems\": [\"urn:…:mrn\"],"
      |code| "  \"handling\": \"operational\" }"
    ] ]
    |block| { height: 26 } []
    |small| "Four lines, and none of them is code."
    |small| "Nothing that writes a Patient has to"
    |small| "remember any of what follows."
  ]

  |col| { width: 76; align: center } [
    |block| { height: 68 } []
    |line| { points: 0 0, 52 0; stroke: --accent; stroke-width: 1.75; marker-end: arrow; }
  ]

  |col| { width: 392; gap: 0 } [
    |eyebrow| "What the engine then enforces"
    |block| { height: 8 } []
    |block#chips| { layout: grid; columns: 188, 192; gap: 10 12 } [
      |live| "the same thing, next time" { width: 188 }
      |live| "every version kept" { width: 192 }
      |live| "an audit trail" { width: 188 }
      |live| "retained for how long" { width: 192 }
      |live| "exportable" { width: 188 }
      |live| "on the change feed" { width: 192 }
    ]
    |block| { height: 22 } []
    |derived| { width: 392 } [ |col| { width: 360; gap: 4 } [
      |capf| "the searchable envelope"
      |small| "derived from the payload, never authoritative,"
      |small| "and rebuildable — so changing how things are"
      |small| "indexed is a background job, not a migration"
    ] ]
  ]
]
