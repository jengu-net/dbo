{
  // Five answers given once per type, instead of at every call site.
  //
  // The left column is deliberately a list of PLACES rather than a list of
  // mistakes: the failure is not that somebody wrote the wrong thing, it is
  // that the question is asked again in each of them.


  // The site's palette. dbo.css maps every one of these onto its own --dbo-*
  // and wins, because Lini's defaults sit in a cascade layer — so these
  // values are only what the figure looks like opened away from the site.
  --ink: #111a24;   --body: #2c3a47;      --muted: #5d6c7b;  --faint: #8695a3;
  --panel: #ffffff; --line: #e3e0da;      --accent: #a8641b; --bg: #fbfaf8;
  --seal: #14532d;  --seal-soft: #e7f0e9; --accent-soft: #f6efe4;

  // Lini's own default stroke is a THREE-digit hex pair, and a three-digit
  // hex is indistinguishable from an issue reference to the branding ratchet
  // — which strips the six-digit form and cannot strip this one. Stating the
  // colour at full length keeps the check honest rather than loosened; and
  // dbo.css maps --lini-stroke onto the site palette like the rest, so this
  // value is only what a figure looks like away from the site.
  --stroke: #444444;
  font-family: "Google Sans"; color: --body;

  // A BARE STRING IS ALWAYS CENTRED in its parent, whatever `align` says;
  // only a block-wrapped one can be placed. So every piece of text that must
  // sit left is wrapped, and its container aligns to start.
  |t::block|       { font-size: 13; color: --body; }
  |small::t|       { font-size: 12.5; color: --muted; }
  |cap::t|         { font-weight: semibold; color: --ink; }
  |eyebrow::t|     { font-size: 11; font-weight: bold; letter-spacing: 1.2;
                     text-transform: uppercase; color: --faint; }
  |col::block|     { layout: flow; direction: column; align: start; gap: 6; }
  |panel::box|     { radius: 9; fill: --panel; stroke: --line; stroke-width: 1.5;
                     padding: 14; align: start; }
  |sealed::panel|  { fill: --seal-soft; stroke: --seal; }
  |dashed::box|    { radius: 9; fill: none; stroke: --faint; stroke-width: 1.5;
                     stroke-style: dashed; padding: 14; align: start; }
  |line-item::box| { radius: 5; fill: --bg; stroke: --line; stroke-width: 1.25;
                     height: 26; padding: 0 12; align: start; justify: center; }
  |lt::t|          { font-size: 12; }
  |has::t|         { font-weight: semibold; color: --seal; }
  |miss::t|        { color: --faint; }
  |body::t|        { color: --muted; }

  // ---- the pattern preset, copied from pattern-icons.lini -----------------
  // Lini has no import, so the icon classes are restated here. A glyph is
  // drawn from three marks and no others: an accent stroke for the thing the
  // pattern is about, a seal fill for what the store guarantees, and a faint
  // dashed outline for what is absent, refused, or merely claimed.
  |tile::box|      { width: 72; height: 72; radius: 12; fill: --bg; stroke: --line;
                     stroke-width: 1.5; layout: stack; padding: 0; }
  |glyph::path|    { fill: none; stroke: --accent; stroke-width: 2.25; }
  |ring::oval|     { fill: none; stroke: --accent; stroke-width: 2.25; }
  |rec::box|       { radius: 3; fill: --panel; stroke: --accent; stroke-width: 2;
                     padding: 0; }
  |solid::box|     { radius: 2; fill: --seal; stroke: none; padding: 0; }
  |sdot::oval|     { fill: --seal; stroke: none; }
  |adot::oval|     { fill: --accent; stroke: none; }
  |ghost::box|     { radius: 3; fill: none; stroke: --faint; stroke-width: 1.5;
                     stroke-style: dashed; padding: 0; }
  |ghostline::line| { stroke: --faint; stroke-width: 1.5; stroke-style: dashed; }
  |bar::line|      { stroke: --accent; stroke-width: 2.25; }
  |arrow::line|    { stroke: --accent; stroke-width: 2.25; marker-end: arrow; }

  layout: flow; direction: column; align: start; width: 760;
  padding: 4; gap: 0; clearance: 2;
  layout: flow; direction: column; align: start; width: 760;
  padding: 4; gap: 0; clearance: 2;
}

|eyebrow| "Asked once, or asked everywhere"
|block| { height: 10 } []

|block| { layout: flow; direction: row; align: start; gap: 24; width: 760 } [

  |col| { width: 368; gap: 0 } [
    |block| { height: 82 } []
    |dashed| { width: 368; height: 200; padding: 16 } [ |col| { width: 334; gap: 8 } [
      |cap| "decided by whoever writes"
      |block| { height: 2 } []
      |line-item| { width: 334; fill: none; stroke-style: dashed } [ |miss| "the import job" ]
      |line-item| { width: 334; fill: none; stroke-style: dashed } [ |miss| "the correction screen" ]
      |line-item| { width: 334; fill: none; stroke-style: dashed } [ |miss| "the nightly clean-up" ]
      |line-item| { width: 334; fill: none; stroke-style: dashed } [ |miss| "and the one written in a hurry" ] ] ]
  ]

  |col| { width: 368; gap: 0 } [
    |tile| [
      |rec| { width: 30; height: 36; translate: -2 2; }
      |solid| { width: 18; height: 10; translate: 10 -14; } ]
    |block| { height: 10 } []
    |sealed| { width: 368; height: 200; padding: 16 } [ |col| { width: 334; gap: 8 } [
      |cap| "declared once, on the type"
      |block| { height: 2 } []
      |line-item| { width: 334; fill: --panel } [ |lt| "may a version be replaced, or only added to" ]
      |line-item| { width: 334; fill: --panel } [ |lt| "is every touch of it audited" ]
      |line-item| { width: 334; fill: --panel } [ |lt| "how long is it kept, at least and at most" ]
      |line-item| { width: 334; fill: --panel } [ |lt| "what identifies one, and what it holds" ] ] ]
  ]
]

|block| { height: 16 } []
|col| { width: 760; gap: 5 } [
  |body| "The engine enforces the right-hand column on every path into the store, including"
  |body| "the ones written after the declaration was made and by somebody who never read it." ]
