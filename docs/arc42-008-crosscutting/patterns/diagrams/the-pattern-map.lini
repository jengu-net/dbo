{
  // Every pattern, and what it rests on.
  //
  // Drawn as a graph rather than a list because the claim IS the shape: one
  // root, and nothing below it standing on its own. A reader who wants to
  // know what a pattern costs reads UPWARDS from it — every box above is a
  // thing that must already be true.
  //
  // The rows are the families, in the order the essays argue them. Links are
  // routed orthogonally and the strategy is set on this scope, because Lini
  // allows one routing strategy per scope.

  // The site's palette. dbo.css maps every one of these onto its own --dbo-*
  // and wins, because Lini's defaults sit in a cascade layer — so these
  // values are only what the figure looks like opened away from the site.
  --ink: #111a24;   --body: #2c3a47;      --muted: #5d6c7b;  --faint: #8695a3;
  --panel: #ffffff; --line: #e3e0da;      --accent: #a8641b; --bg: #fbfaf8;
  --seal: #14532d;  --seal-soft: #e7f0e9; --accent-soft: #f6efe4;

  // Lini's own default stroke is a THREE-digit hex pair, and a three-digit
  // hex is indistinguishable from an issue reference to the branding ratchet
  // — which strips the six-digit form and cannot strip this one. Stating the
  // colour at full length keeps the check honest rather than loosened; and
  // dbo.css maps --lini-stroke onto the site palette like the rest, so this
  // value is only what a figure looks like away from the site.
  --stroke: #444444;
  font-family: "Google Sans"; color: --body;

  |t::block|     { font-size: 13; color: --body; }
  |small::t|     { font-size: 12.5; color: --muted; }
  |eyebrow::t|   { font-size: 11; font-weight: bold; letter-spacing: 1.2;
                   text-transform: uppercase; color: --faint; }
  |col::block|   { layout: flow; direction: column; align: start; gap: 6; }

  // A node is one pattern. The root is sealed because it is the only one
  // that rests on nothing; everything else is an ordinary panel.
  |n::box|       { width: 108; height: 46; radius: 8; fill: --panel;
                   stroke: --line; stroke-width: 1.5; font-size: 11;
                   color: --ink; padding: 4 6; justify: center; }
  |lbl::t|       { font-size: 11; color: --ink; max-width: 94; text-wrap: wrap; }
  |rlbl::lbl|    { color: --seal; font-weight: semibold; }
  |root::n|      { fill: --seal-soft; stroke: --seal; }
  |spacer::block| { width: 108; height: 46; }
  |lane::t|      { font-size: 10; font-weight: bold; letter-spacing: 1.1;
                   text-transform: uppercase; color: --faint; }

  |-|            { stroke: --line; stroke-width: 1.25; marker-end: arrow; }

  layout: grid; columns: repeat(6, 108); rows: auto; gap: 34 22;
  routing: orthogonal; padding: 8; clearance: 2; width: 760;
}

|root#prop|  [ |rlbl| "Property, Not Policy" ]
|spacer| []
|spacer| []
|spacer| []
|spacer| []
|spacer| []

|n#tdb|   [ |lbl| "The Tenant Is a Database" ]
|n#type|  [ |lbl| "A Type Declares What It Is" ]
|n#work|  [ |lbl| "Work Is the Reason" ]
|n#face|  [ |lbl| "Engine and Faces" ]
|n#key|   [ |lbl| "The Person Is a Key" ]
|spacer| []

|n#commit| [ |lbl| "Committed with the Change" ]
|n#trail|  [ |lbl| "The Trail Is Records" ]
|n#run|    [ |lbl| "The Run Is a Record" ]
|n#pull|   [ |lbl| "Nobody Is Pushed" ]
|n#role|   [ |lbl| "A Role Is a Period on a Record" ]
|n#bytes|  [ |lbl| "Bytes Framed, Not Rebuilt" ]

|n#feed|   [ |lbl| "One Feed, Every Consumer" ]
|n#carry|  [ |lbl| "Carrying Is Not Reading" ]
|n#sweep|  [ |lbl| "A Sweep Is Found, Not Started" ]
|n#fall|   [ |lbl| "Falls to a Person, and Is Counted" ]
|n#claim|  [ |lbl| "Two Parties Bound the Claim" ]
|n#leave|  [ |lbl| "Leaving Is the Nightly Path" ]

|n#cursor| [ |lbl| "A Cursor That Holds Still" ]
|n#ask|    [ |lbl| "Asked, Not Scanned" ]
|n#erase|  [ |lbl| "Erasure Destroys a Key" ]
|n#conf|   [ |lbl| "One Declared Set, Applied" ]
|n#zone|   [ |lbl| "A Country Is a Zone" ]
|n#status| [ |lbl| "Status Is a Lifecycle, Not a List" ]

prop -> tdb
prop -> type
prop -> work
prop -> face
prop -> key
tdb -> commit
tdb -> trail
tdb -> key
tdb -> leave
tdb -> status
type -> trail
type -> run
type -> role
type -> face
work -> run
work -> pull
work -> trail
face -> bytes
face -> zone
face -> conf
key -> erase
key -> leave
commit -> feed
trail -> carry
trail -> ask
trail -> erase
run -> sweep
run -> fall
pull -> claim
pull -> fall
pull -> feed
role -> claim
bytes -> carry
feed -> cursor
sweep -> erase
sweep -> conf
claim -> zone
conf -> status
