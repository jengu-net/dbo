{
  // Four layers, and the different thing each one adds when it grows.
  //
  // The figure has one honesty job beside its explaining job: two of these
  // four layers are specified and not built, and they are drawn faint and
  // dashed for the same reason that mark means "absent" everywhere else in
  // this tree. A reader must not be able to take the picture for an
  // inventory.

  // The site's palette. dbo.css maps every one of these onto its own --dbo-*
  // and wins, because Lini's defaults sit in a cascade layer — so these
  // values are only what the figure looks like opened away from the site.
  --ink: #111a24;   --body: #2c3a47;      --muted: #5d6c7b;  --faint: #8695a3;
  --panel: #ffffff; --line: #e3e0da;      --accent: #a8641b; --bg: #fbfaf8;
  --seal: #14532d;  --seal-soft: #e7f0e9; --accent-soft: #f6efe4;

  // Lini's own default stroke is a THREE-digit hex pair, and a three-digit
  // hex is indistinguishable from an issue reference to the branding ratchet
  // — which strips the six-digit form and cannot strip this one. Stating the
  // colour at full length keeps the check honest rather than loosened; and
  // dbo.css maps --lini-stroke onto the site palette like the rest, so this
  // value is only what a figure looks like away from the site.
  --stroke: #444444;
  font-family: "Google Sans"; color: --body;

  // A BARE STRING IS ALWAYS CENTRED in its parent, whatever `align` says;
  // only a block-wrapped one can be placed. So every piece of text that must
  // sit left is wrapped, and its container aligns to start.
  |t::block|       { font-size: 13; color: --body; }
  |small::t|       { font-size: 12.5; color: --muted; }
  |cap::t|         { font-weight: semibold; color: --ink; }
  |eyebrow::t|     { font-size: 11; font-weight: bold; letter-spacing: 1.2;
                     text-transform: uppercase; color: --faint; }
  |col::block|     { layout: flow; direction: column; align: start; gap: 6; }
  |panel::box|     { radius: 9; fill: --panel; stroke: --line; stroke-width: 1.5;
                     padding: 14; align: start; }
  |sealed::panel|  { fill: --seal-soft; stroke: --seal; }
  |dashed::box|    { radius: 9; fill: none; stroke: --faint; stroke-width: 1.5;
                     stroke-style: dashed; padding: 14; align: start; }
  |line-item::box| { radius: 5; fill: --bg; stroke: --line; stroke-width: 1.25;
                     height: 26; padding: 0 12; align: start; justify: center; }
  |lt::t|          { font-size: 12; }
  |has::t|         { font-weight: semibold; color: --seal; }
  |miss::t|        { color: --faint; }
  |body::t|        { color: --muted; }


  |unit::box|   { radius: 6; fill: --panel; stroke: --accent; stroke-width: 1.5;
                  width: 38; height: 38; padding: 0; justify: center; align: center; }
  |unit-on::unit| { fill: --seal-soft; stroke: --seal; }
  |unit-off::box| { radius: 6; fill: none; stroke: --faint; stroke-width: 1.25;
                    stroke-style: dashed; width: 38; height: 38; padding: 0;
                    justify: center; align: center; }
  |plus::t|     { font-size: 16; color: --faint; }
  |tag::t|      { font-size: 10.5; font-weight: bold; letter-spacing: 1;
                  text-transform: uppercase; color: --faint; }

  layout: flow; direction: column; align: start; width: 760;
  padding: 4; gap: 0; clearance: 2;
}

|eyebrow| "What grows, and what one more of it buys"
|block| { height: 10 } []

// ---- entry ---------------------------------------------------------------
|dashed| { width: 760; height: 78; padding: 12 16 } [
  |block| { layout: flow; direction: row; align: center; gap: 16; width: 728 } [
    |col| { width: 520; gap: 3 } [
      |miss| "entry — a place to arrive, not a place to serve"
      |small| "Any node can take the role. A request lands at the one nearest the caller." ]
    |block| { layout: flow; direction: row; align: center; justify: start; gap: 6; width: 138 } [
      |unit-off| [ |plus| "" ]; |unit-off| [ |plus| "" ]; |unit-off| [ |plus| "" ] ]
  ] ]

|block| { height: 7 } []
// ---- serving -------------------------------------------------------------
|dashed| { width: 760; height: 78; padding: 12 16 } [
  |block| { layout: flow; direction: row; align: center; gap: 16; width: 728 } [
    |col| { width: 520; gap: 3 } [
      |miss| "serving — one node holds one tenant's writes"
      |small| "A node more is more tenants served, or one large tenant spread across several." ]
    |block| { layout: flow; direction: row; align: center; justify: start; gap: 6; width: 138 } [
      |unit-off| [ |plus| "" ]; |unit-off| [ |plus| "" ]; |unit-off| [ |plus| "" ] ]
  ] ]

|block| { height: 7 } []
// ---- routing -------------------------------------------------------------
|dashed| { width: 760; height: 78; padding: 12 16 } [
  |block| { layout: flow; direction: row; align: center; gap: 16; width: 728 } [
    |col| { width: 520; gap: 3 } [
      |miss| "routing — a durable assignment of tenant to node"
      |small| "Not a broker. It is state in the store, and a caller never sees it." ]
    |block| { layout: flow; direction: row; align: center; justify: start; gap: 6; width: 138 } [
      |unit-off| [ |plus| "" ] ]
  ] ]

|block| { height: 7 } []
// ---- work ----------------------------------------------------------------
|panel| { width: 760; height: 78; padding: 12 16 } [
  |block| { layout: flow; direction: row; align: center; gap: 16; width: 728 } [
    |col| { width: 520; gap: 3 } [
      |cap| "work — runners that ask for work and report back"
      |small| "A runner more is throughput more. Nothing has to be told it arrived." ]
    |block| { layout: flow; direction: row; align: center; justify: start; gap: 6; width: 138 } [
      |unit| [ |lt| "run" ]; |unit| [ |lt| "run" ]; |unit-off| [ |plus| "+" ] ]
  ] ]

|block| { height: 7 } []
// ---- data ----------------------------------------------------------------
|sealed| { width: 760; height: 78; padding: 12 16 } [
  |block| { layout: flow; direction: row; align: center; gap: 16; width: 728 } [
    |col| { width: 520; gap: 3 } [
      |has| "data — a database per tenant"
      |small| "The unit that moves is a whole tenant, so one never has to be split to be moved." ]
    |block| { layout: flow; direction: row; align: center; justify: start; gap: 6; width: 138 } [
      |unit-on| [ |lt| "A" ]; |unit-on| [ |lt| "B" ]; |unit-off| [ |plus| "+" ] ]
  ] ]

|block| { height: 16 } []
|col| { width: 760; gap: 5 } [
  |body| "Solid is built and dashed is specified without an implementation. So a deployment"
  |body| "today is one node and its databases, and it grows by giving the databases more"
  |body| "room and by adding runners — not yet by adding nodes." ]
