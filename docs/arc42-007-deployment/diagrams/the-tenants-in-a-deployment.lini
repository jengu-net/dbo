{
  // One node, five tenants, and the two kinds of thing that are not inside it.
  //
  // Two separations have to survive being drawn together, and they are not
  // the same separation. Nothing reads another tenant's RECORDS — that is the
  // wall. Definitions and declarations do move between tenants, one way, only
  // where the receiving tenant declared the dependency — that is a door, and
  // drawing it as an exception to the wall would be wrong: it never carries a
  // patient.
  //
  // The top band separates applications from participants because the access
  // rules rest on the difference: an application ASKS the store and holds a
  // token; a participant is OFFERED work and holds an enrolment.

  // The site's palette. dbo.css maps every one of these onto its own --dbo-*
  // and wins, because Lini's defaults sit in a cascade layer — so these
  // values are only what the figure looks like opened away from the site.
  --ink: #111a24;   --body: #2c3a47;      --muted: #5d6c7b;  --faint: #8695a3;
  --panel: #ffffff; --line: #e3e0da;      --accent: #a8641b; --bg: #fbfaf8;
  --seal: #14532d;  --seal-soft: #e7f0e9; --accent-soft: #f6efe4;

  // Lini's own default stroke is a THREE-digit hex pair, and a three-digit
  // hex is indistinguishable from an issue reference to the branding ratchet
  // — which strips the six-digit form and cannot strip this one. Stating the
  // colour at full length keeps the check honest rather than loosened; and
  // dbo.css maps --lini-stroke onto the site palette like the rest, so this
  // value is only what a figure looks like away from the site.
  --stroke: #444444;
  font-family: "Google Sans"; color: --body;

  // A BARE STRING IS ALWAYS CENTRED in its parent, whatever `align` says;
  // only a block-wrapped one can be placed. So every piece of text that must
  // sit left is wrapped, and its container aligns to start.
  |t::block|       { font-size: 13; color: --body; }
  |small::t|       { font-size: 12.5; color: --muted; }
  |cap::t|         { font-weight: semibold; color: --ink; }
  |eyebrow::t|     { font-size: 11; font-weight: bold; letter-spacing: 1.2;
                     text-transform: uppercase; color: --faint; }
  |col::block|     { layout: flow; direction: column; align: start; gap: 6; }
  |panel::box|     { radius: 9; fill: --panel; stroke: --line; stroke-width: 1.5;
                     padding: 14; align: start; }
  |sealed::panel|  { fill: --seal-soft; stroke: --seal; }
  |dashed::box|    { radius: 9; fill: none; stroke: --faint; stroke-width: 1.5;
                     stroke-style: dashed; padding: 14; align: start; }
  |line-item::box| { radius: 5; fill: --bg; stroke: --line; stroke-width: 1.25;
                     height: 26; padding: 0 12; align: start; justify: center; }
  |lt::t|          { font-size: 12; }
  |has::t|         { font-weight: semibold; color: --seal; }
  |miss::t|        { color: --faint; }
  |body::t|        { color: --muted; }

  |down::line|  { points: 0 0, 0 26; stroke: --accent; stroke-width: 1.75;
                  marker-end: arrow; }
  |updown::line| { points: 0 26, 0 0; stroke: --accent; stroke-width: 1.75;
                   marker-end: arrow; }
  |ghostbox::box| { radius: 8; fill: none; stroke: --faint; stroke-width: 1.25;
                    stroke-style: dashed; padding: 10 12; align: start; }

  layout: flow; direction: column; align: start; width: 760;
  padding: 4; gap: 0; clearance: 2;
}

|eyebrow| "Two organisations, and the three tenants that serve them"
|block| { height: 10 } []

// ---- outside ---------------------------------------------------------------
|block| { layout: flow; direction: row; align: start; gap: 12; width: 760 } [
  |panel| { width: 374; height: 114; padding: 12 14 } [ |col| { width: 346; gap: 6 } [
    |cap| "applications — they ask the store"
    |line-item| { width: 346 } [ |lt| "the clinic's own application, over FHIR" ]
    |line-item| { width: 346 } [ |lt| "a host that embeds the store in its JVM" ] ] ]
  |panel| { width: 374; height: 114; padding: 12 14 } [ |col| { width: 346; gap: 6 } [
    |cap| "participants — they are offered work"
    |line-item| { width: 346 } [ |lt| "a bench instrument, behind a router" ]
    |line-item| { width: 346 } [ |lt| "a supplier's own system, elsewhere" ] ] ]
]

|block| { height: 4 } []
|block| { layout: flow; direction: row; align: start; gap: 12; width: 760 } [
  |block| { width: 374; height: 34 } [ |down| { pin: center } ]
  |block| { width: 374; height: 34 } [ |updown| { pin: center } ]
]
|block| { height: 2 } []
|block| { layout: flow; direction: row; align: start; gap: 12; width: 760 } [
  |col| { width: 374; gap: 0 } [
    |small| "a token from that tenant's own issuer" ]
  |col| { width: 374; gap: 0 } [
    |small| "an enrolment, and work it asked for" ] ]
|block| { height: 12 } []

// ---- the node --------------------------------------------------------------
|dashed| { width: 760; height: 268; padding: 12 } [ |col| { width: 736; gap: 8 } [
  |cap| "one node — one process, one port"

  |block| { layout: grid; columns: repeat(3, 240); gap: 8 } [
    |panel| { width: 240; height: 74; padding: 10 12 } [ |col| { width: 216; gap: 3 } [
      |cap| "zone: the country"
      |small| "which brokers authenticate,"
      |small| "which identifiers prove" ] ]
    |panel| { width: 240; height: 74; padding: 10 12 } [ |col| { width: 216; gap: 3 } [
      |cap| "face root: FHIR R4"
      |small| "the version's structures,"
      |small| "searches, value sets, codes" ] ]
    |sealed| { width: 240; height: 74; padding: 10 12 } [ |col| { width: 216; gap: 3 } [
      |has| "managing"
      |small| "what this deployment was"
      |small| "told to serve, as records" ] ]
  ]

  |block| { layout: grid; columns: repeat(3, 240); gap: 8 } [
    |block| { width: 240; height: 28 } [ |down| { pin: center } ]
    |block| { width: 240; height: 28 } [ |down| { pin: center } ]
    |block| { width: 240; height: 28 } []
  ]
  |col| { width: 736; gap: 0 } [
    |small| "one way, and only what the tenant below declared it takes — read-only where it lands," 
    |small| "stamped with where it came from, and never a person" ]

  |block| { layout: grid; columns: repeat(2, 364); gap: 8 } [
    |panel| { width: 364; height: 74; padding: 10 12 } [ |col| { width: 340; gap: 3 } [
      |cap| "tenant: the clinic"
      |small| "its own issuer and keys, its own people," 
      |small| "served at its own path" ] ]
    |panel| { width: 364; height: 74; padding: 10 12 } [ |col| { width: 340; gap: 3 } [
      |cap| "tenant: the laboratory"
      |small| "its own issuer and keys, its own people,"
      |small| "served at its own path" ] ]
  ]
] ]

|block| { height: 4 } []
|col| { width: 760; gap: 0 } [
  |small| "a connection handed to each, and never a credential the operator holds" ]
|block| { height: 8 } []

// ---- the databases ---------------------------------------------------------
|block| { layout: grid; columns: repeat(5, 144); gap: 8 } [
  |sealed| { width: 144; height: 62; padding: 8 10 } [ |col| { width: 124; gap: 2 } [
    |has| "the clinic"; |small| "its own database" ] ]
  |sealed| { width: 144; height: 62; padding: 8 10 } [ |col| { width: 124; gap: 2 } [
    |has| "the laboratory"; |small| "its own database" ] ]
  |sealed| { width: 144; height: 62; padding: 8 10 } [ |col| { width: 124; gap: 2 } [
    |has| "the zone"; |small| "its own database" ] ]
  |sealed| { width: 144; height: 62; padding: 8 10 } [ |col| { width: 124; gap: 2 } [
    |has| "the face root"; |small| "its own database" ] ]
  |sealed| { width: 144; height: 62; padding: 8 10 } [ |col| { width: 124; gap: 2 } [
    |has| "managing"; |small| "its own database" ] ]
]

|block| { height: 14 } []
|dashed| { width: 760; height: 60; padding: 12 16 } [ |col| { width: 728; gap: 3 } [
  |miss| "what is not drawn because it does not exist: a read of another tenant's records, for"
  |miss| "anybody including the operator; a broker beside the databases; a call from the node out" ] ]
