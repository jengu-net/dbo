{
  // The deployable units, and why they are separate processes rather than
  // one. Drawn as containers because the claim is about PRIVILEGE: each box
  // outside the runtime holds less than the runtime does, and the one that
  // holds most is the one a tenant's data never leaves.

  layout: flow; direction: column; gap: 30; padding: 26;

  // Lini's own default stroke is a THREE-digit hex pair, and a three-digit
  // hex is indistinguishable from an issue reference to the branding ratchet.
  // Stating the colour at full length keeps the check honest rather than
  // loosened; dbo.css maps --lini-* onto the site palette either way.
  --stroke: #444444;
  --accent: #a8641b; --accent-soft: #f6efe4;
  --seal: #14532d;   --seal-soft: #e7f0e9;
  --faint: #8695a3;  --line: #e3e0da;      --bg: #fbfaf8;
  font-family: "Google Sans"; font-size: 13;

  |served::box|  { fill: --seal-soft; stroke: --seal; }
  |beside::box|  { fill: --accent-soft; stroke: --accent; }
  |group|        { gap: 16; }
}

|group#beside| "Plain jars, each its own process and credentials" [
  |beside#operator| "The operator: provisions against Kubernetes"
  |beside#fleet| "The fleet reader: reads a deployment from outside"
  |beside#verify| "The verifier: checks an archive with no network"
]

|group#runtime| "One OSGi container, the shipped distribution" [
  |served#bundles| "Every bundle that touches tenant data"
  |served#faces| "A face per FHIR version"
  |served#tenants| "A runtime per tenant"
]

|cyl#pg| "PostgreSQL, a database per tenant" { fill: --seal-soft; stroke: --seal; }

beside -> runtime "provisions it, reads it, holds none of its data"
runtime -> pg "the only data store"
