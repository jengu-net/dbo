#!/usr/bin/env bash
#
# The check. CI runs this file and nothing else, so "green locally" and
# "green on CI" are the same sentence about the same command.
#
# THREE PHASES, and the daemon stops after the first. That is not tidiness: a full
# build and :core:harness:distTest cannot share one daemon on a developer
# machine, because the dist test boots the shipped distribution as a SECOND
# JVM on top of a build's resident memory and the daemon is killed mid-task.
# CI does not hit it — a runner starts from a stopped daemon and the split
# keeps the two out of one JVM's lifetime there — which is exactly
# why the workflow cannot be the place this order is written down.
#
# The dials are NOT here. They are in gradle.properties, so that a bare
# ./gradlew test uses them too. Arguments are forwarded, which is how CI pins
# a release version (-Pdbo.version=X.Y.Z).
#
#   ./verify                      # what CI runs
#   ./verify -Pdbo.version=1.2.3  # what CI runs for a tag
set -euo pipefail
cd "$(dirname "$0")"

# The conformance report is not in here, and the exclusion is the point. It is
# a REPORT: it passes as long as it managed to observe the server, nothing
# ratchets the markdown it writes, and it cost ten minutes of a forty-minute
# check to regenerate three versions of observations. A proof suite that waits
# for a report is one people run less often.
#
#   ./gradlew :core:conformance:test     # regenerate it, when the face moved
#
# CI runs it as a job of its own, beside this one rather than inside it.
echo "=== phase 1/3: build (without the distribution test) ==="
# The guide suite is out of this phase because build runs it against the
# PINNED image, which cannot prove anything this tree changed. Phase 3 runs
# it against a server built from this tree; the pinned run has a job of its
# own in CI, where it guards the published commands rather than the code.
./gradlew build -x :core:harness:distTest -x :guide:test -x :core:conformance:test "$@"

# The whole point of the split; see above.
./gradlew --stop

echo "=== phase 2/3: the shipped distribution ==="
./gradlew :core:harness:distTest "$@"

echo "=== phase 3/3: the guide, against this tree ==="
./docs/guide/examples/guide-on-tree.sh "$@"
