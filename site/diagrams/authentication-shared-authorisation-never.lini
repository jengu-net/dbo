{
  // Authentication is shared; authorisation never is.
  //
  // The third tenant refuses the SAME valid identity, which is the whole
  // drawing: a verified person is not an authorised one, and the refusal has
  // to sit beside the two grants rather than be described elsewhere.

  // The site's palette. dbo.css maps every one of these onto its own --dbo-*
  // and wins, because Lini's defaults sit in a cascade layer — so these
  // values are only what the figure looks like opened away from the site.
  --ink: #111a24;   --body: #2c3a47;      --muted: #5d6c7b;  --faint: #8695a3;
  --panel: #ffffff; --line: #e3e0da;      --accent: #a8641b; --bg: #fbfaf8;
  --seal: #14532d;  --seal-soft: #e7f0e9; --accent-soft: #f6efe4;

  // Lini's own default stroke is a THREE-digit hex pair, and a three-digit
  // hex is indistinguishable from an issue reference to the branding ratchet
  // — which strips the six-digit form and cannot strip this one. Stating the
  // colour at full length keeps the check honest rather than loosened; and
  // dbo.css maps --lini-stroke onto the site palette like the rest, so this
  // value is only what a figure looks like away from the site.
  --stroke: #444444;
  font-family: "Google Sans"; color: --body;

  // A BARE STRING IS ALWAYS CENTRED in its parent, whatever `align` says;
  // only a block-wrapped one can be placed. So every piece of text that must
  // sit left is wrapped, and its container aligns to start.
  |t::block|       { font-size: 13; color: --body; }
  |small::t|       { font-size: 12.5; color: --muted; }
  |cap::t|         { font-weight: semibold; color: --ink; }
  |capf::cap|      { color: --faint; }
  |eyebrow::t|     { font-size: 11; font-weight: bold; letter-spacing: 1.2;
                     text-transform: uppercase; color: --faint; }
  |col::block|     { layout: flow; direction: column; align: start; gap: 6; }
  |panel::box|     { radius: 9; fill: --panel; stroke: --line; stroke-width: 1.5;
                     padding: 14; align: start; }
  |line-item::box| { radius: 5; fill: --bg; stroke: --line; stroke-width: 1.25;
                     height: 26; padding: 0 12; align: start; justify: center; }
  |lt::t|          { font-size: 12; }
  |sealchip::box| { radius: 7; fill: --seal-soft; stroke: --seal; stroke-width: 1.25;
                    height: 30; padding: 0; justify: center; align: center;
                    font-size: 12; font-weight: semibold; color: --seal; }
  |ghostchip::sealchip| { fill: none; stroke: --line; stroke-style: dashed;
                          color: --faint; font-weight: normal; }
  |miss::t|   { color: --faint; }
  |down::line| { points: 0 0, 0 22; stroke: --accent; stroke-width: 1.75; marker-end: arrow; }
  |across::line| { points: 0 0, 48 0; stroke: --accent; stroke-width: 1.75; marker-end: arrow; }

  layout: flow; direction: row; align: start; width: 760;
  padding: 4; gap: 0; clearance: 2;
}

|col| { width: 200; gap: 0 } [
  |eyebrow| "Shared across the deployment"
  |block| { height: 8 } []
  |panel| { width: 196; height: 52; padding: 10 16 } [ |col| { width: 164; gap: 4 } [
    |cap| "a national broker"
    |small| "the store authenticates nobody" ] ]
  |block| { width: 196; height: 30 } [ |down| { pin: center } ]
  |panel| { width: 196; height: 66; padding: 10 16 } [ |col| { width: 164; gap: 4 } [
    |cap| "one session"
    |small| "a verified identifier and"
    |small| "the time of the ceremony —" ] ]
  |block| { height: 12 } []
  |col| { width: 196; gap: 0 } [ |miss| "no name, no national code" ]
]

|block| { width: 64; height: 200 } [ |across| { pin: center; translate: 0 -40 } ]

|col| { width: 240; gap: 0 } [
  |eyebrow| "Never shared"
  |block| { height: 8 } []
  |panel| { width: 240; height: 76; padding: 12 16 } [ |col| { width: 208; gap: 8 } [
    |cap| "county hospital"
    |sealchip| "an active role — in" { width: 208 } ] ]
  |block| { height: 10 } []
  |panel| { width: 240; height: 76; padding: 12 16 } [ |col| { width: 208; gap: 8 } [
    |cap| "private clinic"
    |sealchip| "an active role — in" { width: 208 } ] ]
  |block| { height: 10 } []
  |panel| { width: 240; height: 76; padding: 12 16 } [ |col| { width: 208; gap: 8 } [
    |cap| "a hospital across the country"
    |ghostchip| "no active role — refused" { width: 208 } ] ]
]

|col| { width: 236; gap: 0 } [
  |block| { height: 34 } []
  |col| { width: 236; gap: 5 } [
    |small| "The same person, the same"
    |small| "ceremony, three answers." ]
  |block| { height: 12 } []
  |col| { width: 236; gap: 5 } [
    |small| "Each tenant resolves them in"
    |small| "its own records and mints its"
    |small| "own token. A token from one"
    |small| "fails at another's signature"
    |small| "check before a claim is read." ]
  |block| { height: 16 } []
  |col| { width: 236; gap: 5 } [
    |small| "Revoking access is ending a"
    |small| "period on an ordinary record."
    |small| "There is no second user"
    |small| "directory to go stale." ]
]
