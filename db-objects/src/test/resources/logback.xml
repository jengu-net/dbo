<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <!--withJansi>true</withJansi-->
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%-31thread] %highlight(%-5level) %logger{50} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="io.dbobjects" level="INFO"/>
    <logger name="liquibase" level="INFO"/>
    <logger name="liquibase.changelog.StandardChangeLogHistoryService" level="WARN"/>
    <logger name="io.dbobjects.audit" level="DEBUG"/>
    <logger name="liquibase" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
