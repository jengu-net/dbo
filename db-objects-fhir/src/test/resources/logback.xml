<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%-31thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="io.dbobjects" level="INFO"/>
    <logger name="com.zaxxer.hikari" level="WARN"/>
    <logger name="ca.uhn.fhir.parser" level="ERROR"/>

    <logger name="org.gradle.internal.execution.impl" level="DEBUG"/>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
