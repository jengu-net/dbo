# Copy to .env and change the password. .env is git-ignored; this file is not.
#
# These are read on the instance's FIRST boot and stored from then on, so
# changing them later edits nothing — to start over, `docker compose down -v`
# and bring it back up.

# Must look like an email with a real domain; `dev@localhost` is refused.
DBO_O2_EMAIL=dev@example.com

# Eight characters or more, with an upper, a lower, a digit and a symbol.
DBO_O2_PASSWORD=ChangeMe1!
